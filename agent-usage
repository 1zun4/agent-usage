CONFIG_FILE = "config.json"
NOT_USAGE_FILES = ("schema.json", CONFIG_FILE)

ROOT_FIELDS = ("date", "change", "tool", "models")
MODEL_FIELDS = ("model", "provider", "tokens", "usd")
TOKEN_FIELDS = ("input", "cachedInput", "cacheWrite", "output")

FILE_NAME = re.compile(r"([0-9]{4}-[0-9]{2}-[0-9]{2})-[0-9a-f]{8}\.json")
DATE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
HEX_ID = re.compile(r"[0-9a-f]{8}")
# A lowercase name, then hyphenated parts of which at least one holds a version number
MODEL_ID = re.compile(r"[a-z][a-z0-9]*(-[a-z0-9.]*[a-z0-9])*-[a-z]*[0-9][a-z0-9.]*(-[a-z0-9.]*[a-z0-9])*")

SUMMARY_START = "<!-- agent-usage -->"
SUMMARY_END = "<!-- /agent-usage -->"


class Failure(Exception):
    """An error the user can fix; printed without a traceback."""


def is_number(value):
    return isinstance(value, (int, Decimal)) and not isinstance(value, bool)


def child(value, key):
    return value.get(key) if isinstance(value, dict) else None


def count(usage, key):
    value = child(usage, key)
    return int(value) if is_number(value) else 0


def tokens(input=0, cached_input=0, cache_write=0, output=0):
    return {"input": input, "cachedInput": cached_input, "cacheWrite": cache_write, "output": output}


def add_tokens(a, b):
    return {key: a[key] + b[key] for key in TOKEN_FIELDS}


def cents(usd):
    return usd.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)


# Session logs


@dataclass
class Turn:
    """One model call. usd is None when the log has no cost; then priced_as names the model on the price list."""

    time: datetime | None
    tool: str
    provider: str
    model: str
    tokens: dict
    usd: Decimal | None
    priced_as: str
    cache_write_1h: int = 0


@dataclass
class SessionLog:
    """The model calls in one omp or Claude Code JSONL log (.jsonl or .jsonl.gz)."""

    file: Path
    session_id: str | None
    is_main: bool
    title: str | None
    turns: list


def log_files(paths):
    """The logs at paths: folders are searched, and a log file brings the subagent logs in the folder of its name."""
    files = {}
    for path in paths:
        if path.is_dir():
            files.update(dict.fromkeys(logs_under(path)))
        elif path.is_file():
            files[path.resolve()] = None
            name = path.name.removesuffix(".gz").removesuffix(".jsonl")
            if (path.parent / name).is_dir():
                files.update(dict.fromkeys(logs_under(path.parent / name)))
        else:
            raise Failure(f"{path} does not exist.")
    return list(files)


def logs_under(folder):
    found = [p.resolve() for p in folder.rglob("*") if p.is_file() and p.name.endswith((".jsonl", ".jsonl.gz"))]
    return sorted(found, key=lambda p: (str(p).count(os.sep), str(p)))


def instant(value):
    """A timestamp with an offset, or None."""
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value)
    except ValueError:
        return None
    return parsed if parsed.tzinfo else None


def model_name(model):
    """The id as written in @agent tags: without provider prefix and release date (claude-opus-4-5-20251101)."""
    return re.sub(r"-[0-9]{8}$", "", model.rsplit("/", 1)[-1])


def omp_turn(entry, provider, model, usage):
    if not isinstance(usage, dict) or not isinstance(model, str):
        return None
    counts = tokens(count(usage, "input"), count(usage, "cacheRead"), count(usage, "cacheWrite"), count(usage, "output"))
    total = child(usage.get("cost"), "total")
    usd = Decimal(total) if is_number(total) else Decimal(0)
    if not any(counts.values()) and usd == 0:
        return None
    if not (isinstance(provider, str) and provider.strip()):
        if "/" not in model:
            raise Failure(f"No provider recorded for model {model}.")
        provider = model.split("/", 1)[0]
    return Turn(instant(entry.get("timestamp")), "omp", provider, model_name(model), counts, usd, model_name(model))


def claude_turn(entry, message):
    usage = message.get("usage")
    model = message.get("model")
    if not isinstance(usage, dict) or not isinstance(model, str):
        return None
    if model.startswith("<"):  # <synthetic>: local error messages, no API call
        return None
    counts = tokens(
        count(usage, "input_tokens"),
        count(usage, "cache_read_input_tokens"),
        count(usage, "cache_creation_input_tokens"),
        count(usage, "output_tokens"),
    )
    if not any(counts.values()):
        return None
    provider = model.split("/", 1)[0] if "/" in model else "anthropic"
    return Turn(
        instant(entry.get("timestamp")),
        "claude-code",
        provider,
        model_name(model),
        counts,
        None,
        model.rsplit("/", 1)[-1],
        count(usage.get("cache_creation"), "ephemeral_1h_input_tokens"),
    )


def read_log(file):
    """omp logs every assistant message and side call with tokens and cost. Claude Code logs tokens only and writes
    one line per content block, so its calls are counted once per message id."""
    session_id = None
    is_main = True
    title = None
    turns = []
    claude_messages = set()
    opener = gzip.open if file.name.endswith(".gz") else open
    with opener(file, "rt", encoding="utf-8") as lines:
        for number, line in enumerate(lines, 1):
            if not line.strip():
                continue
            try:
                entry = json.loads(line, parse_float=Decimal)
            except ValueError as error:
                raise Failure(f"{file}:{number} is not JSON: {error}") from error
            if not isinstance(entry, dict):
                continue
            message = entry.get("message") if isinstance(entry.get("message"), dict) else None
            kind = entry.get("type")
            turn = None
            if kind == "session":
                session_id = entry.get("id") if isinstance(entry.get("id"), str) else None
                is_main = entry.get("parentSession") is None
            elif kind in ("title", "title_change", "summary"):
                value = entry.get("title") if entry.get("title") is not None else entry.get("summary")
                if isinstance(value, str) and value.strip():
                    title = value
            elif kind == "message" and message is not None and message.get("role") == "assistant":
                turn = omp_turn(entry, message.get("provider"), message.get("model"), message.get("usage"))
            elif kind == "model_usage":
                turn = omp_turn(entry, entry.get("provider"), entry.get("model"), entry.get("usage"))
            elif kind == "assistant" and message is not None:
                if session_id is None and isinstance(entry.get("sessionId"), str):
                    session_id = entry["sessionId"]
                if entry.get("isSidechain") is True:
                    is_main = False
                message_id = message.get("id") if isinstance(message.get("id"), str) else None
                if message_id is None or message_id not in claude_messages:
                    claude_messages.add(message_id)
                    turn = claude_turn(entry, message)
            if turn is not None:
                turns.append(turn)
    return SessionLog(file, session_id, is_main, title, turns)


class PriceList:
    """List prices from models.dev in USD per million tokens, for logs that record tokens but no cost."""

    def __init__(self, providers):
        self.providers = providers

    @classmethod
    def fetch(cls):
        try:
            with urllib.request.urlopen(PRICE_URL, timeout=60) as response:
                return cls(json.loads(response.read(), parse_float=Decimal))
        except (OSError, ValueError) as error:
            raise Failure(f"Could not download the price list {PRICE_URL}: {error}") from error

    def usd(self, provider, model, counts, cache_write_1h):
        """Anthropic bills cache writes kept for an hour at twice the input price."""
        cost = child(child(child(self.providers, provider), "models"), model)
        cost = child(cost, "cost")
        if not isinstance(cost, dict):
            raise Failure(
                f"models.dev ({PRICE_URL}) has no price for {provider}/{model}. "
                "Write this usage file by hand from the provider's prices."
            )

        def price(key):
            value = cost.get(key)
            return Decimal(value) if is_number(value) else None

        input_price = price("input")
        output_price = price("output")
        if input_price is None:
            raise Failure(f"models.dev lists no input price for {provider}/{model}.")
        if output_price is None:
            raise Failure(f"models.dev lists no output price for {provider}/{model}.")
        cache_read = price("cache_read") if price("cache_read") is not None else input_price
        cache_write = price("cache_write") if price("cache_write") is not None else input_price
        total = (
            input_price * counts["input"]
            + cache_read * counts["cachedInput"]
            + cache_write * (counts["cacheWrite"] - cache_write_1h)
            + input_price * 2 * cache_write_1h
            + output_price * counts["output"]
        )
        return total / Decimal(1_000_000)


# Usage files


def quote(text):
    out = ['"']
    for char in text:
        if char == '"':
            out.append('\\"')
        elif char == "\\":
            out.append("\\\\")
        elif char == "\n":
            out.append("\\n")
        elif char < " ":
            out.append(f"\\u{ord(char):04x}")
        else:
            out.append(char)
    out.append('"')
    return "".join(out)


def usage_json(day, change, tool, models):
    """The file text; models are (model, provider, tokens, usd) tuples."""
    lines = ["{", f'  "date": {quote(day.isoformat())},', f'  "change": {quote(change)},', f'  "tool": {quote(tool)},']
    lines.append('  "models": [')
    for index, (model, provider, counts, usd) in enumerate(models):
        lines += [
            "    {",
            f'      "model": {quote(model)},',
            f'      "provider": {quote(provider)},',
            f'      "tokens": {{ "input": {counts["input"]}, "cachedInput": {counts["cachedInput"]}, '
            f'"cacheWrite": {counts["cacheWrite"]}, "output": {counts["output"]} }},',
            f'      "usd": {cents(usd):f}',
            "    }" if index == len(models) - 1 else "    },",
        ]
    lines += ["  ]", "}"]
    return "\n".join(lines) + "\n"


def option_time(text, option):
    """An ISO time; without an offset it is local time, a date alone its start."""
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        raise Failure(
            f"{option} {text} is not an ISO time like 2026-11-13T14:05:00Z, 2026-11-13T15:05 or 2026-11-13."
        ) from None
    return parsed if parsed.tzinfo else parsed.astimezone()


def record(paths, directory, start=None, end=None, change=None, file_id=None, prices=PriceList.fetch):
    """Writes a usage file from session logs and returns its path, the logs and the models written."""
    logs = [read_log(file) for file in log_files(paths)]
    turns = [
        turn
        for log in logs
        for turn in log.turns
        if (start is None and end is None)
        or (turn.time is not None and (start is None or turn.time >= start) and (end is None or turn.time <= end))
    ]
    if not turns:
        between = " between --from and --to." if start is not None or end is not None else "."
        raise Failure(f"No model calls found in {', '.join(map(str, paths))}{between}")

    main = next((log for log in logs if log.is_main and log.session_id), None) or next(
        (log for log in logs if log.session_id), None
    )
    if file_id is None and main is not None:
        file_id = "".join(char for char in main.session_id if char.isalnum()).lower()[:8]
    if file_id is None or not HEX_ID.fullmatch(file_id):
        raise Failure("The logs name no session id with 8 hex digits; pass --id <8 lowercase hex> (any random ones).")
    if change is None or not change.strip():
        if main is None or main.title is None:
            raise Failure('The session has no title; pass --change "type(scope): subject" of the change.')
        change = main.title.strip()

    price_list = None
    groups = {}
    for turn in turns:
        if turn.usd is None and price_list is None:
            price_list = prices()
        usd = turn.usd if turn.usd is not None else price_list.usd(
            turn.provider, turn.priced_as, turn.tokens, turn.cache_write_1h
        )
        model, provider, counts, total, tools = groups.get(
            (turn.provider, turn.model), (turn.model, turn.provider, tokens(), Decimal(0), set())
        )
        groups[(turn.provider, turn.model)] = (model, provider, add_tokens(counts, turn.tokens), total + usd, tools | {turn.tool})
    # Models that cost nothing (free tiers, local models) are left out
    kept = sorted((group for group in groups.values() if cents(group[3]) > 0), key=lambda group: group[3], reverse=True)
    if not kept:
        raise Failure("Every model call in these logs cost $0.00, so there is nothing to record.")

    times = [turn.time for turn in turns if turn.time is not None]
    day = max(times).astimezone().date() if times else date.today()
    tool = ", ".join(sorted(set().union(*(group[4] for group in kept))))
    models = [group[:4] for group in kept]
    file = directory / f"{day.isoformat()}-{file_id}.json"
    if file.exists():
        raise Failure(
            f"{file} already exists, and usage files are never overwritten. "
            "If it is another change from the same session, pass --id <8 lowercase hex> (any random ones)."
        )
    directory.mkdir(parents=True, exist_ok=True)
    file.write_text(usage_json(day, change, tool, models), encoding="utf-8")
    return file, logs, turns, models


def validate(name, data):
    """What is wrong with a parsed usage file named name; empty when it is valid."""
    problems = []
    name_match = FILE_NAME.fullmatch(name)
    if name_match is None:
        problems.append("the name is not `<yyyy-mm-dd>-<8 lowercase hex>.json`")
    if not isinstance(data, dict):
        return problems + ["the file is not a JSON object"]

    def only(node, path, fields):
        problems.extend(f"unknown field `{path}{key}`" for key in node if key not in fields)

    def need(node, path, field, expected, valid):
        if field not in node:
            problems.append(f"`{path}{field}` is missing")
        elif not valid(node[field]):
            problems.append(f"`{path}{field}` must be {expected}")

    def text(value):
        return isinstance(value, str) and value.strip() != ""

    only(data, "", ROOT_FIELDS)
    need(data, "", "date", "a string `yyyy-mm-dd`", is_date)
    if name_match and is_date(data.get("date")) and name_match.group(1) != data["date"]:
        problems.append(f"the name starts with {name_match.group(1)} but `date` is {data['date']}")
    need(data, "", "change", "a non-empty string", text)
    need(data, "", "tool", "a non-empty string", text)
    need(data, "", "models", "a non-empty array", lambda value: isinstance(value, list) and value)

    for index, usage in enumerate(data["models"] if isinstance(data.get("models"), list) else []):
        if not isinstance(usage, dict):
            problems.append(f"`models[{index}]` must be an object")
            continue
        path = f"models[{index}]."
        only(usage, path, MODEL_FIELDS)
        need(usage, path, "model", "a non-empty string", text)
        need(usage, path, "provider", "a non-empty string", text)
        need(usage, path, "usd", "a number >= 0", lambda value: is_number(value) and value >= 0)
        need(usage, path, "tokens", "an object", lambda value: isinstance(value, dict))
        if isinstance(usage.get("tokens"), dict):
            only(usage["tokens"], f"{path}tokens.", TOKEN_FIELDS)
            for field in TOKEN_FIELDS:
                need(usage["tokens"], f"{path}tokens.", field, "an integer >= 0", is_count)
    return problems


def is_count(value):
    return is_number(value) and value >= 0 and value == int(value)


def is_date(value):
    if not isinstance(value, str) or not DATE.fullmatch(value):
        return False
    try:
        date.fromisoformat(value)
        return True
    except ValueError:
        return False


def default_usage_dir():
    """.agent-usage, or agent-usage when only that folder exists in the working directory."""
    if Path(OLD_USAGE_DIR).is_dir() and not Path(USAGE_DIR).exists():
        return Path(OLD_USAGE_DIR)
    return Path(USAGE_DIR)


def usage_files(directory):
    if not directory.is_dir():
        return []
    return sorted(p for p in directory.iterdir() if p.is_file() and p.suffix == ".json" and p.name not in NOT_USAGE_FILES)


def load(file):
    return json.loads(file.read_text(encoding="utf-8"), parse_float=Decimal)


# Doc comments


def strip_block(line):
    return line.strip().removeprefix("/**").removesuffix("*/").strip().removeprefix("*").strip()


def block_comments(lines):
    """/** ... */ comments: KDoc, Javadoc, JSDoc, TSDoc, PHPDoc, Doxygen."""
    comments = []
    index = 0
    while index < len(lines):
        if not lines[index].lstrip().startswith("/**"):
            index += 1
            continue
        comment = []
        while index < len(lines):
            comment.append((index + 1, strip_block(lines[index])))
            if "*/" in lines[index]:
                break
            index += 1
        index += 1
        comments.append(comment)
    return comments


def rust_comments(lines):
    """Runs of /// or //! lines, plus /** */ blocks."""
    comments = block_comments(lines)
    run = []
    for number, line in enumerate(lines, 1):
        stripped = line.strip()
        if (stripped.startswith("///") and not stripped.startswith("////")) or stripped.startswith("//!"):
            run.append((number, stripped[3:].strip()))
        elif run:
            comments.append(run)
            run = []
    if run:
        comments.append(run)
    return comments


DOCSTRING = re.compile(r"""^\s*[rRuU]?(\"\"\"|''')""")


def python_comments(lines):
    """Triple-quoted strings that start a line.

    shortcut: any such string counts as a docstring, not only the first statement of a module, class or def;
    parse with ast if a project keeps @-lines in other triple-quoted strings.
    """
    comments = []
    index = 0
    while index < len(lines):
        match = DOCSTRING.match(lines[index])
        if not match:
            index += 1
            continue
        quote_mark = match.group(1)
        comment = []
        body = lines[index][match.end():]
        while True:
            end = body.find(quote_mark)
            comment.append((index + 1, (body if end < 0 else body[:end]).strip()))
            if end >= 0 or index + 1 >= len(lines):
                break
            index += 1
            body = lines[index]
        index += 1
        comments.append(comment)
    return comments


STYLES = {"block": block_comments, "rust": rust_comments, "python": python_comments}
EXTENSION_STYLES = {
    **dict.fromkeys(
        ".kt .kts .java .scala .groovy .js .jsx .mjs .cjs .ts .tsx .mts .cts .php .c .h .cc .cpp .hpp .swift".split(),
        "block",
    ),
    ".rs": "rust",
    ".py": "python",
    ".pyi": "python",
}


def doc_tags(comments):
    """(line, tag) of every line starting with @ in the comments, outside ``` code blocks, per comment."""
    result = []
    for comment in comments:
        tags = []
        in_code = False
        for number, text in comment:
            if text.startswith("```"):
                in_code = not in_code
            if not in_code and text.startswith("@"):
                tags.append((number, text))
        result.append(tags)
    return result


def is_agent_tag(tag):
    return tag == "@agent" or tag.startswith("@agent ")


def agent_tags(path, lines, style):
    """The @agent tags in a file as (line, model or None when malformed), and its placement problems."""
    found = []
    problems = []
    for tags in doc_tags(STYLES[style](lines)):
        first = next((i for i, (_, tag) in enumerate(tags) if is_agent_tag(tag)), None)
        if first is None:
            continue
        for number, tag in tags[first:]:
            location = f"{path}:{number}"
            if not is_agent_tag(tag):
                problems.append(f"{location}: `{tag}` follows an @agent tag; @agent tags go last")
                continue
            model = tag.removeprefix("@agent").strip()
            if MODEL_ID.fullmatch(model):
                found.append((number, model))
            else:
                problems.append(f"{location}: `{tag}` is not `@agent <name>-<version>`")
                found.append((number, None))
    return found, problems


def git(root, *args):
    """git's stdout, or None when it fails or git is missing."""
    try:
        result = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True)
    except OSError:
        return None
    return result.stdout if result.returncode == 0 else None


def source_files(root, includes, excludes, styles):
    """(relative path, style) of the files to check: git's tracked and unignored files, or every file outside a git repo."""
    listed = git(root, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
    if listed is not None:
        paths = sorted({path for path in listed.split("\0") if path})
    else:
        paths = []
        for folder, folders, files in os.walk(root):
            folders[:] = [f for f in folders if not f.startswith(".") and f not in ("node_modules", "build", "target")]
            paths += [Path(folder, f).relative_to(root).as_posix() for f in files]
        paths.sort()
    found = []
    for path in paths:
        if includes and not any(fnmatch.fnmatchcase(path, glob) for glob in includes):
            continue
        if any(fnmatch.fnmatchcase(path, glob) for glob in excludes):
            continue
        style = next((style for glob, style in styles if fnmatch.fnmatchcase(path, glob)), None)
        style = style or EXTENSION_STYLES.get(os.path.splitext(path)[1])
        if style and (root / path).is_file():
            found.append((path, style))
    return found


def added_lines(root, merge_base):
    """Lines added since merge_base per file; None for untracked files, which are new as a whole."""
    added = {}
    file = None
    line = 0
    for diff_line in (git(root, "diff", "-U0", "--no-color", "--no-ext-diff", merge_base) or "").splitlines():
        if diff_line.startswith("+++ "):
            file = diff_line[4:].removeprefix("b/")
        elif diff_line.startswith("@@"):
            match = re.search(r"\+([0-9]+)", diff_line)
            line = int(match.group(1)) if match else 0
        elif diff_line.startswith("+"):
            added.setdefault(file, set()).add(line)
            line += 1
    for path in (git(root, "ls-files", "--others", "--exclude-standard") or "").splitlines():
        if path:
            added[path] = None
    return added


def check(root, directory, base, includes=(), excludes=(), styles=()):
    """Every problem in the usage files and @agent tags, as messages; empty when all is well.

    Usage files at the base are never changed, a change that adds or changes @agent tags adds a usage file, and
    every model in an @agent tag has a usage file. The base rules are skipped when the base ref is missing.
    """
    problems = []
    folder = directory.relative_to(root).as_posix() if directory.is_relative_to(root) else str(directory)

    schema_file = directory / "schema.json"
    if schema_file.is_file():
        problems += schema_problems(folder, load(schema_file))
    if (directory / CONFIG_FILE).is_file():
        try:
            config_related(directory / CONFIG_FILE)
        except Failure as failure:
            problems.append(str(failure))

    files = usage_files(directory)
    used_models = set()
    for file in files:
        try:
            data = load(file)
        except ValueError as error:
            problems.append(f"{folder}/{file.name}: not valid JSON ({error}).")
            continue
        problems += [f"{folder}/{file.name}: {problem}." for problem in validate(file.name, data)]
        for usage in child(data, "models") if isinstance(child(data, "models"), list) else []:
            if isinstance(child(usage, "model"), str):
                used_models.add(usage["model"])

    tags = []
    for path, style in source_files(root, includes, excludes, styles):
        lines = (root / path).read_text(encoding="utf-8", errors="replace").splitlines()
        found, tag_problems = agent_tags(path, lines, style)
        problems += tag_problems
        tags += [(path, number, model) for number, model in found]

    unused = {}
    for path, number, model in tags:
        if model is not None and model not in used_models:
            unused.setdefault(model, []).append(f"{path}:{number}")
    for model, places in unused.items():
        more = f" and {len(places) - 1} more" if len(places) > 1 else ""
        problems.append(
            f"Model `{model}` is named in @agent tags ({places[0]}{more}) but in no {folder} file. "
            f"Add a usage file with its tokens and cost: agent-usage record <session log>, or write one by hand."
        )

    problems += base_problems(root, folder, base, {f"{folder}/{file.name}" for file in files}, tags)
    return problems


def schema_problems(folder, schema):
    model = child(child(child(schema, "properties"), "models"), "items")
    token_node = child(child(model, "properties"), "tokens")
    problems = []
    for what, node, fields in (
        ("the file", schema, ROOT_FIELDS),
        ("models[]", model, MODEL_FIELDS),
        ("tokens", token_node, TOKEN_FIELDS),
    ):
        required = [str(field) for field in child(node, "required") or []]
        if set(required) != set(fields):
            problems.append(
                f"{folder}/schema.json requires {required} for {what}, but agent-usage checks {list(fields)}. "
                "Replace it with the schema.json of agent-usage."
            )
    return problems


def base_problems(root, folder, base, files, tags):
    merge_base = None
    if git(root, "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}") is not None:
        merge_base = (git(root, "merge-base", base, "HEAD") or "").strip()
    if not merge_base:
        print(f"agent-usage: no commit {base} with a merge base on HEAD, so changes against it are not checked.", file=sys.stderr)
        return []

    problems = []
    base_files = [
        path
        for path in (git(root, "ls-tree", "-r", "--name-only", merge_base, "--", f"{folder}/") or "").splitlines()
        if path.endswith(".json") and path.rpartition("/")[2] not in NOT_USAGE_FILES
    ]
    for path in base_files:
        if not (root / path).is_file():
            change = "was deleted"
        elif git(root, "diff", "--quiet", merge_base, "--", path) is None:
            change = "was changed"
        else:
            continue
        problems.append(
            f"{path} {change}, but files in {folder}/ are never edited or removed. "
            f"Restore it (git checkout {base} -- {path}) and add a new file for this change."
        )

    added = added_lines(root, merge_base)
    changed = next(
        (f"{path}:{number}" for path, number, _ in tags if path in added and (added[path] is None or number in added[path])),
        None,
    )
    if changed is not None and not files - set(base_files):
        problems.append(
            f"This change adds or changes @agent tags ({changed}) but adds no {folder} file. "
            "Run agent-usage record <session log> and commit the new file."
        )
    return problems


# Summary


def config_related(file):
    """The `related` list of a usage folder's config.json."""
    try:
        related = child(load(file), "related")
    except ValueError as error:
        raise Failure(f"{file} is not valid JSON ({error}).") from None
    if not isinstance(related, list) or not all(isinstance(source, str) and source.strip() for source in related):
        raise Failure(f'{file} must be {{"related": ["OWNER/REPO" or a checkout path, ...]}}.')
    return related


def related_sources(directory, flags=()):
    """(label, base folder, source) of the related repositories: the usage folder's config.json (paths relative to
    its checkout), then AGENT_USAGE_RELATED, then --related. Labels name the input and position, never the source."""
    groups = []
    config = directory / CONFIG_FILE
    if config.is_file():
        groups.append((f"{directory.name}/{CONFIG_FILE}", directory.resolve().parent, config_related(config)))
    env = os.environ.get(RELATED_ENV)
    if env is not None:
        if not env.strip():
            raise Failure(f"{RELATED_ENV} is set but empty; in CI that usually means its secret is missing.")
        groups.append((RELATED_ENV, Path.cwd(), env.split()))
    groups.append(("--related", Path.cwd(), list(flags)))
    return [
        (f"Related repository {number} of {where}", base, source)
        for where, base, sources in groups
        for number, source in enumerate(sources, 1)
    ]


def related_files(label, base, source):
    """(name, text) of the usage files of a related repository, a local checkout or OWNER/REPO on GitHub."""
    path = base / Path(source).expanduser()
    if path.is_dir():
        folder = path / USAGE_DIR if (path / USAGE_DIR).is_dir() else path / OLD_USAGE_DIR
        files = [(file.name, file.read_text(encoding="utf-8")) for file in usage_files(folder)]
    elif REPO.fullmatch(source):
        files = github_files(label, source)
    else:
        raise Failure(f"{label} is neither a folder nor OWNER/REPO.")
    if not files:
        raise Failure(f"{label} has no usage files.")
    return files


def github_token():
    """GH_TOKEN, GITHUB_TOKEN, or the token of a signed-in gh CLI."""
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        return token
    try:
        return subprocess.run(["gh", "auth", "token"], capture_output=True, text=True).stdout.strip()
    except OSError:
        return ""


GITHUB_QUERY = """query($owner: String!, $name: String!) {
  repository(owner: $owner, name: $name) {
    current: object(expression: "HEAD:.agent-usage") { ...files }
    old: object(expression: "HEAD:agent-usage") { ...files }
  }
}
fragment files on Tree { entries { name type object { ... on Blob { text isTruncated } } } }"""


def github_files(label, repo):
    """The usage files on the default branch of repo, in one GraphQL request."""
    token = github_token()
    if not token:
        raise Failure(
            f"{label} is on GitHub, but no token is set. "
            "Set GH_TOKEN or GITHUB_TOKEN to a token that can read its contents."
        )
    owner, name = repo.split("/")
    request = urllib.request.Request(
        GRAPHQL_URL,
        data=json.dumps({"query": GITHUB_QUERY, "variables": {"owner": owner, "name": name}}).encode(),
        headers={"Authorization": f"bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            reply = json.loads(response.read())
    except urllib.error.HTTPError as error:
        raise Failure(f"{label}: GitHub refused the request (HTTP {error.code}); check the token.") from None
    except (OSError, ValueError) as error:
        raise Failure(f"{label}: could not read it from GitHub ({error}).") from None
    repository = child(child(reply, "data"), "repository")
    if repository is None:
        raise Failure(
            f"{label} was not found on GitHub, or the token cannot read it. "
            "Give the token read access to its contents."
        )
    files = []
    for entry in child(repository.get("current") or repository.get("old"), "entries") or []:
        if entry.get("type") != "blob" or not entry["name"].endswith(".json") or entry["name"] in NOT_USAGE_FILES:
            continue
        blob = entry.get("object") or {}
        if not isinstance(blob.get("text"), str) or blob.get("isTruncated"):
            raise Failure(f"{label}: GitHub did not return the whole text of a usage file.")
        files.append((entry["name"], blob["text"]))
    return files


def repository_key(base, source):
    """What tells repositories apart: the resolved path of a checkout, or owner/repo in lowercase."""
    path = base / Path(source).expanduser()
    return str(path.resolve()) if path.is_dir() else source.lower()


def own_keys(directory):
    """The keys of the repository that holds directory: its checkout and its GitHub origin."""
    checkout = directory.resolve().parent
    origin = (git(checkout, "remote", "get-url", "origin") or "").strip() if checkout.is_dir() else ""
    match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$", origin)
    return {str(checkout)} | ({match.group(1).lower()} if match else set())


def totals(directory, related=()):
    """Sums per model and provider, the most expensive first, the number of files, how many of them come from
    related repositories (related_sources, with the --related values), how many related repositories were counted,
    and the first and last date. A repository listed twice, or the one holding directory, counts once."""
    sources = [(str(file), file.name, file.read_text(encoding="utf-8")) for file in usage_files(directory)]
    own = own_keys(directory)
    seen = set(own)
    related_changes = 0
    for label, base, source in related_sources(directory, related):
        key = repository_key(base, source)
        if key in seen:
            continue
        seen.add(key)
        files = related_files(label, base, source)
        related_changes += len(files)
        sources += [(f"{label}: a usage file", name, text) for name, text in files]
    sums = {}
    dates = []
    for label, name, text in sources:
        try:
            data = json.loads(text, parse_float=Decimal)
        except ValueError as error:
            raise Failure(f"{label} is not valid JSON ({error}); run agent-usage check.") from error
        if validate(name, data):
            raise Failure(f"{label} is not a valid usage file; run agent-usage check.")
        dates.append(data["date"])
        for usage in data["models"]:
            key = (usage["model"], usage["provider"])
            counts, usd = sums.get(key, (tokens(), Decimal(0)))
            sums[key] = (add_tokens(counts, {k: int(v) for k, v in usage["tokens"].items()}), usd + usage["usd"])
    rows = sorted(((m, p, c, u) for (m, p), (c, u) in sums.items()), key=lambda row: (-row[3], row[0], row[1]))
    related_repos = len(seen) - len(own)
    return rows, len(dates), related_changes, related_repos, min(dates, default=None), max(dates, default=None)


def summary_table(directory, related=()):
    rows, changes, related_changes, related_repos, first, last = totals(directory, related)
    if not rows:
        raise Failure(f"{directory} holds no usage files.")
    total = tokens()
    lines = [
        "| Model | Provider | Input | Cached input | Cache write | Output | USD |",
        "| --- | --- | --: | --: | --: | --: | --: |",
    ]
    for model, provider, counts, usd in rows:
        total = add_tokens(total, counts)
        lines.append(f"| {model} | {provider} | " + " | ".join(f"{counts[k]:,}" for k in TOKEN_FIELDS) + f" | {cents(usd):,.2f} |")
    usd = sum((row[3] for row in rows), Decimal(0))
    lines.append("| **Total** | | " + " | ".join(f"**{total[k]:,}**" for k in TOKEN_FIELDS) + f" | **{cents(usd):,.2f}** |")
    noun = "change" if changes == 1 else "changes"
    repos = "repository" if related_repos == 1 else "repositories"
    of_them = f", {related_changes} of them in {related_repos} related {repos}" if related_repos else ""
    lines += ["", f"{changes} {noun} from {first} to {last}{of_them}, in USD at the providers' list prices."]
    return "\n".join(lines) + "\n"


def summary_json(directory, related=()):
    """The totals as JSON: usd, changes, relatedChanges, first, last and the models with tokens and usd."""
    rows, changes, related_changes, _, first, last = totals(directory, related)
    if not rows:
        raise Failure(f"{directory} holds no usage files.")
    models = [
        {"model": model, "provider": provider, "tokens": counts, "usd": float(cents(usd))}
        for model, provider, counts, usd in rows
    ]
    usd = float(cents(sum((row[3] for row in rows), Decimal(0))))
    data = {"usd": usd, "changes": changes, "relatedChanges": related_changes, "first": first, "last": last, "models": models}
    return json.dumps(data, indent=2) + "\n"


# Card

# panel, border, text, muted, and the color of providers without their own
THEMES = {
    "dark": ("#0d1117", "#30363d", "#e6edf3", "#8b949e", "#6e7681"),
    "light": ("#ffffff", "#d0d7de", "#1f2328", "#59636e", "#8c959f"),
}
PROVIDER_COLORS = {
    "anthropic": "#d97757",
    "deepseek": "#4d6bfe",
    "opencode-go": "#e5484d",
    "github-copilot": "#8957e5",
    "openai": "#10a37f",
}


def escape(text):
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def dollars(usd):
    return f"${cents(Decimal(usd)):,.2f}"


def abbreviated(count):
    """count with a K, M or B suffix: one decimal below 100 of the unit, none above."""
    for size, unit in ((1_000_000_000, "B"), (1_000_000, "M"), (1_000, "K")):
        if count >= size:
            value = count / size
            return (f"{value:.1f}" if value < 100 else f"{value:.0f}") + unit
    return str(count)


def card_svg(rows, changes, first, last, theme):
    """The usage card: total cost, a bar of the models' shares, a row per model and the dates. Models that cost
    nothing are left out."""
    panel, border, text_color, muted, other = THEMES[theme]
    rows = [row for row in rows if cents(row[3]) > 0]
    total = sum((row[3] for row in rows), Decimal(0))
    width, pad = 560, 20
    bar = width - 2 * pad
    body = []

    def text(x, y, value, fill, size=13, weight=400, end=False):
        attributes = f' font-size="{size}"' if size != 13 else ""
        attributes += f' font-weight="{weight}"' if weight != 400 else ""
        attributes += ' text-anchor="end"' if end else ""
        body.append(f'<text x="{x}" y="{y}" fill="{fill}"{attributes}>{escape(value)}</text>')

    text(pad, 34, "AI usage", text_color, size=14, weight=600)
    if not rows:
        text(pad, 62, "No usage recorded yet.", muted)
        height = 84
    else:
        body.append(
            f'<text x="{pad}" y="78" fill="{text_color}" font-size="32" font-weight="700">{escape(dollars(total))}'
            f'<tspan font-size="20" dy="-10" fill="{muted}">*</tspan></text>'
        )
        text(pad, 100, "* if billed at full API rate", muted, size=12)
        # Further models of a provider get lighter shades of its color
        seen = {}
        fills = []
        for _, provider, _, _ in rows:
            seen[provider] = seen.get(provider, 0) + 1
            opacity = (1, 0.7, 0.5, 0.35)[min(seen[provider], 4) - 1]
            fills.append(f'fill="{PROVIDER_COLORS.get(provider, other)}" fill-opacity="{opacity}"')
        shares = [row[3] / total for row in rows]
        body.append(f'<clipPath id="bar"><rect x="{pad}" y="116" width="{bar}" height="10" rx="5"/></clipPath>')
        body.append('<g clip-path="url(#bar)">')
        start = Decimal(0)
        for index, share in enumerate(shares):
            left = round(start * bar)
            start += share
            right = round(start * bar) - (0 if index == len(rows) - 1 else 2)
            if right > left:
                body.append(f'<rect x="{pad + left}" y="116" width="{right - left}" height="10" {fills[index]}/>')
        body.append("</g>")
        text(36, 152, "Model", muted, size=11)
        text(220, 152, "Provider", muted, size=11)
        text(400, 152, "Cost", muted, size=11, end=True)
        text(466, 152, "Share", muted, size=11, end=True)
        text(width - pad, 152, "Tokens", muted, size=11, end=True)
        y = 152
        for index, (model, provider, counts, usd) in enumerate(rows):
            y += 24
            share = shares[index]
            body.append(f'<circle cx="{pad + 5}" cy="{y - 4.5}" r="4.5" {fills[index]}/>')
            text(36, y, model if len(model) <= 25 else model[:24] + "…", text_color)
            text(220, y, provider if len(provider) <= 16 else provider[:15] + "…", muted)
            text(400, y, dollars(usd), text_color, end=True)
            text(466, y, "<0.1%" if 0 < share < Decimal("0.0005") else f"{share * 100:.1f}%", muted, end=True)
            text(width - pad, y, abbreviated(sum(counts.values())), muted, end=True)
        body.append(f'<line x1="{pad}" y1="{y + 14}" x2="{width - pad}" y2="{y + 14}" stroke="{border}"/>')
        noun = "1 change" if changes == 1 else f"{changes} changes"
        text(pad, y + 36, f"{noun}, {first}" if first == last else f"{noun}, {first} to {last}", muted, size=12)
        height = y + 52
    title = f"{dollars(total)}* (* if billed at full API rate)" if rows else "none recorded yet"
    head = (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}" '
        "font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif\" "
        'font-size="13" style="font-variant-numeric: tabular-nums" role="img">\n'
        f"<title>AI usage: {escape(title)}</title>\n"
        f'<rect x="0.5" y="0.5" width="{width - 1}" height="{height - 1}" rx="10" fill="{panel}" stroke="{border}"/>'
    )
    return head + "\n" + "\n".join(body) + "\n</svg>\n"


def write_card(directory, out, name, related=()):
    """ai-usage-dark.svg, ai-usage-light.svg, ai-usage.json and an ai-usage/ page listing this repository's
    changes, for a static site such as GitHub Pages."""
    rows, changes, related_changes, _, first, last = totals(directory, related)
    out.mkdir(parents=True, exist_ok=True)
    for theme in THEMES:
        (out / f"ai-usage-{theme}.svg").write_text(card_svg(rows, changes, first, last, theme), encoding="utf-8")
    (out / "ai-usage.json").write_text(summary_json(directory, related) if rows else "{}\n", encoding="utf-8")
    changes_rows = []
    for file in sorted(usage_files(directory), key=lambda file: file.name, reverse=True):
        data = load(file)
        models = ", ".join(model["model"] for model in data["models"])
        usd = sum((Decimal(model["usd"]) for model in data["models"]), Decimal(0))
        changes_rows.append(
            f"<tr><td>{escape(data['date'])}</td><td>{escape(data['change'])}</td>"
            f"<td>{escape(models)}</td><td>{dollars(usd)}</td></tr>"
        )
    noun = "change" if related_changes == 1 else "changes"
    hidden = (
        f"<p>The totals also count {related_changes} {noun} in related projects that are not public.</p>\n"
        if related_changes
        else ""
    )
    page = (
        '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
        '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
        f"<title>AI usage of {escape(name)}</title>\n"
        "<style>body{font:15px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','Noto Sans',Helvetica,Arial,sans-serif;"
        "max-width:860px;margin:2rem auto;padding:0 1rem;color:#1f2328}table{border-collapse:collapse;width:100%}"
        "td,th{text-align:left;padding:.3rem .6rem;border-bottom:1px solid #d0d7de}td:last-child{text-align:right}"
        "@media(prefers-color-scheme:dark){body{background:#0d1117;color:#e6edf3}td,th{border-color:#30363d}}"
        "</style>\n</head>\n<body>\n"
        f"<h1>AI usage of {escape(name)}</h1>\n<p><picture>\n"
        '<source media="(prefers-color-scheme: dark)" srcset="../ai-usage-dark.svg">\n'
        f'<img alt="AI models used in {escape(name)} and their cost" src="../ai-usage-light.svg">\n</picture></p>\n'
        "<table>\n<thead><tr><th>Date</th><th>Change</th><th>Models</th><th>Cost</th></tr></thead>\n<tbody>\n"
        + "\n".join(changes_rows)
        + f"\n</tbody>\n</table>\n{hidden}"
        '<p>Totals per model as JSON: <a href="../ai-usage.json">ai-usage.json</a></p>\n</body>\n</html>\n'
    )
    (out / "ai-usage").mkdir(exist_ok=True)
    (out / "ai-usage" / "index.html").write_text(page, encoding="utf-8")


def update_summary(file, table):
    """Replaces the text between the summary markers in file; returns whether it changed."""
    text = file.read_text(encoding="utf-8")
    start = text.find(SUMMARY_START)
    end = text.find(SUMMARY_END, start + 1)
    if start < 0 or end < 0:
        raise Failure(f"{file} has no {SUMMARY_START} ... {SUMMARY_END} block to put the summary in.")
    updated = text[: start + len(SUMMARY_START)] + "\n" + table + text[end:]
    if updated != text:
        file.write_text(updated, encoding="utf-8")
    return updated != text


# Command line


def style_option(text):
    glob, _, style = text.rpartition("=")
    if not glob or style not in STYLES:
        raise argparse.ArgumentTypeError(f"expected GLOB=STYLE with STYLE one of {', '.join(STYLES)}")
    return glob, style


def main(argv=None):
    parser = argparse.ArgumentParser(prog="agent-usage", description="What the AI agents that wrote a project cost.")
    parser.add_argument(
        "--dir", type=Path, help=f"the usage folder (default {USAGE_DIR}, or {OLD_USAGE_DIR} when only that exists)"
    )
    commands = parser.add_subparsers(dest="command", required=True)

    record_parser = commands.add_parser("record", help="write a usage file from omp or Claude Code session logs")
    record_parser.add_argument("paths", nargs="+", type=Path, help="session logs (.jsonl, .jsonl.gz) or folders")
    record_parser.add_argument("--from", dest="start", help="first model call to count, ISO time")
    record_parser.add_argument("--to", dest="end", help="last model call to count, ISO time")
    record_parser.add_argument("--change", help="the commit subject (default: the session title)")
    record_parser.add_argument("--id", dest="file_id", help="8 lowercase hex digits (default: from the session id)")

    check_parser = commands.add_parser("check", help="check the usage files and the @agent tags")
    check_parser.add_argument("--base", default="origin/main", help="git ref the change is compared with")
    check_parser.add_argument("--include", action="append", default=[], help="glob of source files to check")
    check_parser.add_argument("--exclude", action="append", default=[], help="glob of source files to skip")
    check_parser.add_argument(
        "--style", action="append", default=[], type=style_option, help=f"GLOB=STYLE, STYLE one of {', '.join(STYLES)}"
    )

    summary_parser = commands.add_parser("summary", help="totals per model as a markdown table")
    output = summary_parser.add_mutually_exclusive_group()
    output.add_argument("--update", type=Path, help=f"put the table between {SUMMARY_START} and {SUMMARY_END}")
    output.add_argument("--json", action="store_true", help="print the totals as JSON instead of a table")
    related_help = (
        f"also count these repositories (checkouts or OWNER/REPO on GitHub), besides {RELATED_ENV} and the "
        f"related list in the usage folder's {CONFIG_FILE}; never named in the output"
    )
    summary_parser.add_argument("--related", action="extend", nargs="+", default=[], help=related_help)

    card_parser = commands.add_parser("card", help="the totals as SVG cards and a page, for a static site")
    card_parser.add_argument("--out", type=Path, required=True, help="folder the files are written to")
    card_parser.add_argument("--name", required=True, help="the project's name, for the page and the image text")
    card_parser.add_argument("--related", action="extend", nargs="+", default=[], help=related_help)

    args = parser.parse_args(argv)
    args.dir = args.dir or default_usage_dir()
    try:
        if args.command == "record":
            start = option_time(args.start, "--from") if args.start else None
            end = option_time(args.end, "--to") if args.end else None
            paths = [path.expanduser() for path in args.paths]
            file, logs, turns, models = record(paths, args.dir, start, end, args.change, args.file_id)
            print(f"Wrote {file} from {len(logs)} logs, {len(turns)} model calls:")
            for model, provider, counts, usd in models:
                print(
                    f"  {provider}/{model}: {cents(usd)} USD, {counts['input']} input, {counts['cachedInput']} cached "
                    f"input, {counts['cacheWrite']} cache write, {counts['output']} output"
                )
        elif args.command == "check":
            root = Path.cwd().resolve()
            problems = check(root, (root / args.dir).resolve(), args.base, args.include, args.exclude, args.style)
            if problems:
                print("agent-usage check failed:\n" + "\n".join(f"- {problem}" for problem in problems), file=sys.stderr)
                return 1
            print(f"agent-usage check passed ({len(usage_files(root / args.dir))} usage files).")
        elif args.command == "card":
            write_card(args.dir, args.out, args.name, args.related)
            print(f"Wrote the AI usage card to {args.out}")
        elif args.json:
            print(summary_json(args.dir, args.related), end="")
        elif args.update:
            changed = update_summary(args.update, summary_table(args.dir, args.related))
            print(f"{'Updated' if changed else 'Already current:'} {args.update}")
        else:
            print(summary_table(args.dir, args.related), end="")
    except Failure as failure:
        print(f"agent-usage: {failure}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
